# Скопируйте в .env: cp .env.example .env

# --- Нейросеть ---
# mock — шаблонный генератор без внешнего API (по умолчанию, ключи не нужны)
# openai — любой OpenAI-совместимый API: OpenAI, OpenRouter, DeepSeek, vLLM, Ollama
# yandex — YandexGPT, данные не покидают РФ
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# json_schema для OpenAI/OpenRouter; json_object для API без поддержки строгих схем (DeepSeek)
OPENAI_JSON_MODE=json_schema

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# --- Защита бюджета публичного демо ---
MAX_ROWS_PER_FILE=50
BATCHES_PER_HOUR=3
GENERATIONS_PER_HOUR=20
BATCH_TTL_HOURS=24

# --- Инфраструктура (для запуска без Docker) ---
# Подходят и строки вида postgres://…?sslmode=require (Neon, Supabase) — они приводятся к asyncpg
DATABASE_URL=postgresql+asyncpg://cardforge:cardforge@localhost:5432/cardforge
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
# Регулярка для превью-деплоев, например ^https://cardforge-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Очередь ---
# arq — отдельный воркер (Docker, VPS); poll — без воркера, для Vercel (там выбирается сам)
QUEUE_MODE=arq
# Секрет для Vercel Cron, который раз в сутки вызывает /api/cron/cleanup
CRON_SECRET=
